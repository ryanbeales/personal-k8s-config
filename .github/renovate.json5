{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  extends: [
    "config:recommended"
  ],

  platformAutomerge: true,
  automergeType: "pr",
  prConcurrentLimit: 10,

  // Define a custom manager that will look for a comment above the version dependnency line and contain details on how to update it
  customManagers: [
    // Define a custom regex manager to find annotated dependencies in deployment, Kustomization and values files
    {
      // Documentation here https://docs.renovatebot.com/modules/manager/regex/
      customType: "regex",
      description: "Annotated dependencies in deployment, Kustomization and values files",
      managerFilePatterns: [
        "**/*deployment.y?ml",
        "**/daemonset.y?ml",
        "**/*cronjob*.y?ml",
        "**/*-values.y?ml",
        "**/values-*.y?ml",
        "**/values.y?ml",
        "iac-services/crossplane-providers/providers/**/*.yaml",
      ],
      matchStrings: [
        // Use in image tag lines or in values files
        // Examples:
        //   renovate: datasource=github-tags depname=blakeblackshear/frigate versioning=docker
        //   tag: 0.16.1-tensorrt
        //   renovate: datasource=github-tags depname=esphome/esphome versioning=semver
        //   image: esphome/esphome:2025.8.4
        "# renovate: datasource=(?<datasource>.*?) depname=(?<depName>.*?)( versioning=(?<versioning>.*?))?\\s+(?:-\\s+)?\\S+?:\\s(\\S+?:)?(?<currentValue>[^@\\s]+)(@(?<currentDigest>sha256:[a-f0-9]+))?",
      ],
      versioningTemplate: "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}",
    },

    // Matchers for kustomization files
    {
      customType: "regex",
      description: "Direct GitHub references",
      managerFilePatterns: [
        "**/kustomization.yaml",
        "**/Kustomization"
      ],
      matchStrings: [
        // Example: https://raw.githubusercontent.com/argoproj/argo-cd/v3.1.5/manifests/install.yaml
        "# renovate: datasource=(?<datasource>.*?) depname=(?<depName>.*?)( versioning=(?<versioning>.*?))?\\s+-\\s\\S+?raw\\.githubusercontent\\.com\\/\\S+?\\/\\S+?\\/(?<currentValue>\\S+?)\\/",
      ],
      versioningTemplate: "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}",
    },
  ],

  // Allow automatic merging for some "safe" dependencies. Argocd is in there, I think that's fine...
  packageRules: [
    {
      matchDepNames: [
        "renovatebot/renovate", 
        "esphome/esphome",
        "argoproj/argo-cd",
        "kube-prometheus-stack",
        "prometheus-community/charts/kube-prometheus-stack",
        "ghcr.io/prometheus-community/charts/kube-prometheus-stack",
        "loki",
        "grafana/loki",
        "promtail",
        "grafana/promtail",
        "gateway-helm",
        "envoyproxy/gateway-helm",
        "home-assistant/core"
      ],
      automerge: true
    },
    {
      description: "Automerge minor and patch updates for low-risk, frequently updated apps and helpers",
      matchDepNames: [
        "docker.io/searxng/searxng",
        "ghcr.io/nesquena/hermes-webui",
        "ghcr.io/windmill-labs/windmill",
        "ghcr.io/windmill-labs/windmill-extra",
        "open-webui/open-webui",
        "ghcr.io/thespaghettidetective/moonraker-obico",
        "portainer/kubectl-shell",
        "n8nio/n8n",
        "neosmemo/memos",
        "zwave-js/zwave-js-ui",
        "mkuf/klipper"
      ],
      matchUpdateTypes: ["minor", "patch"],
      automerge: true
    },
    {
      description: "Automerge patch-only updates for stateful, GPU, and hardware-sensitive services",
      matchDepNames: [
        "immich-app/immich",
        "qdrant/qdrant",
        "ghcr.io/blakeblackshear/frigate",
        "NVIDIA/k8s-device-plugin"
      ],
      matchUpdateTypes: ["patch"],
      automerge: true
    },
    {
      description: "Pin Frigate init container python version to match Frigate image",
      matchFileNames: [
        "self-hosted-services/frigate/frigate-install/values.yaml"
      ],
      matchDepNames: [
        "python"
      ],
      enabled: false
    },
    {
      description: "Preserve CUDA compatibility suffix (-cu128) for Kokoro GPU image",
      matchDepNames: [
        "ghcr.io/remsky/kokoro-fastapi-gpu"
      ],
      versioning: "regex:^v?(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-(?<compatibility>cu\\d+)$"
    },
    {
      description: "Parse git-describe commit counts as build numbers for Klipper and Moonraker",
      matchDepNames: [
        "mkuf/klipper",
        "mkuf/moonraker"
      ],
      versioning: "regex:^v?(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(?:-(?<build>\\d+)-g[0-9a-f]+)?$"
    }
  ],

  ignoreDeps: [
    // Ignore all other dependencies not matched by the custom regex manager
    "postgresql",
    "mbentley/omada-controller"
  ],

  ignorePaths: [
    // Ignore any files in the archived directory
    "archived/**"
  ],
}